generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  ADMIN
}

enum ReceiptStatus {
  PENDING
  PROCESSED
  REJECTED
  DUPLICATE
}

enum TransactionType {
  CASHBACK_REWARD
  WITHDRAWAL
  ADJUSTMENT
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  username  String   @unique
  name      String
  password  String
  role      Role     @default(USER)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  wallet   Wallet?
  receipts Receipt[]

  @@map("users")
}

model Category {
  id        String        @id @default(cuid())
  name      String        @unique
  slug      String        @unique
  items     ReceiptItem[]
  createdAt DateTime      @default(now()) @map("created_at")

  @@map("categories")
}

model Receipt {
  id             String        @id @default(cuid())
  userId         String        @map("user_id")
  receiptHash    String        @unique @map("receipt_hash")
  imageUrl       String        @map("image_url")
  vkn            String?       @db.VarChar(10)
  merchantName   String?       @map("merchant_name")
  receiptNo      String?       @map("receipt_no")
  receiptDate    DateTime?     @map("receipt_date")
  totalAmount    Decimal       @map("total_amount") @db.Decimal(10, 2)
  cashbackAmount Decimal       @map("cashback_amount") @db.Decimal(10, 2)
  status         ReceiptStatus @default(PENDING)
  rawOcrText     String?       @map("raw_ocr_text") @db.Text
  ocrEngineUsed  String?       @map("ocr_engine_used")
  fallbackUsed   Boolean       @default(false) @map("fallback_used")
  createdAt      DateTime      @default(now()) @map("created_at")
  updatedAt      DateTime      @updatedAt @map("updated_at")

  user         User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  items        ReceiptItem[]
  transactions WalletTransaction[]

  @@index([userId])
  @@map("receipts")
}

model ReceiptItem {
  id         String   @id @default(cuid())
  receiptId  String   @map("receipt_id")
  categoryId String?  @map("category_id")
  itemName   String   @map("item_name")
  quantity   Int      @default(1)
  unitPrice  Decimal  @map("unit_price") @db.Decimal(10, 2)
  totalPrice Decimal  @map("total_price") @db.Decimal(10, 2)
  createdAt  DateTime @default(now()) @map("created_at")

  receipt  Receipt   @relation(fields: [receiptId], references: [id], onDelete: Cascade)
  category Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  @@map("receipt_items")
}

model Wallet {
  id        String   @id @default(cuid())
  userId    String   @unique @map("user_id")
  balance   Decimal  @default(0.00) @db.Decimal(10, 2)
  updatedAt DateTime @updatedAt @map("updated_at")

  user         User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions WalletTransaction[]

  @@map("wallets")
}

model WalletTransaction {
  id              String          @id @default(cuid())
  walletId        String          @map("wallet_id")
  receiptId       String?         @map("receipt_id")
  amount          Decimal         @db.Decimal(10, 2)
  transactionType TransactionType @map("transaction_type")
  description     String?
  createdAt       DateTime        @default(now()) @map("created_at")

  wallet  Wallet   @relation(fields: [walletId], references: [id], onDelete: Cascade)
  receipt Receipt? @relation(fields: [receiptId], references: [id], onDelete: SetNull)

  @@map("wallet_transactions")
}
